let display := [ProjectArgs at: 0 ifAbsent: [| nil]];

[[display isNil]
  ifTrue: [|
    [System println: ["birnam-twin over Twin protocol " , [Twin protocolVersionString]]];
    [System println: "Pass a display for a managed-window smoke: birnam run -- :0"]]
  ifFalse: [|
    let result := [Twin withConnectionTo: display do: [:connection |
      [connection withWindow: "birnam-twin" width: 48 height: 10 cursor: [Twin cursorLine]
        attributes: [Twin defaultWindowAttributes] flags: [Twin defaultWindowFlags] do: [:window |
        let painted := [window
          => foreground: [TwinColor brightWhite] background: [TwinColor blueColor]
          => clear
          => write: "managed Twin window" atX: 2 y: 1
          => fillCodepoint: 32 fromX: 2 y: 3 width: 30 height: 2
            foreground: [TwinColor black] background: [TwinColor brightCyan]
          => foreground: [TwinColor black] background: [TwinColor brightCyan]
          => write: "nonblocking event sample" atX: 4 y: 3
          => focus
          => sync];
        [painted ifNotError: [:ready | [connection nextEvent]]]]]]];
    let message := [[result isError]
      ifTrue: [| [result printString]]
      ifFalse: [|
        [[result isNil]
          ifTrue: [| "no event queued (window closed)"]
          ifFalse: [| [["event: " , [[result kind] printString]] , " (window closed)"]]]]];
    [System println: message]]]
